# ==== Required Keys ====
MAPPLS_API_KEY=PASTE_YOUR_KEY
SERP_API_KEY=PASTE_YOUR_KEY
WEATHER_API_KEY=PASTE_YOUR_KEY
GROQ_API_KEY=PASTE_YOUR_KEY
# Groq retired llama-3.3-70b-versatile on 2026-08-16 (developer tier).
GROQ_MODEL=openai/gpt-oss-120b

# ==== Optional ===
WEATHER_PROVIDER=openweather
HTTP_TIMEOUT_SECONDS=30
# Whole LangGraph network timeout (seconds). gpt-oss plus five agents
# often exceeds 40 s even when Serp/Weather keys are unset.
AGENT_TIMEOUT_SECONDS=90
SCORING_STATE_PATH=./data/scoring_state.json
LOG_LEVEL=INFO
ENABLE_GDELT=false
ENABLE_COMTRADE=false
ALLOW_GEMINI_FALLBACK=true
